---11 solutions
SELECT *
FROM EMPLOYEES
Where salary > 60000;
---12 solutions
SELECT department, count(*) as total_employees
FROM EMPLOYEES
Group by department;
---13 solutions
SELECT department, AVG(salary) as Average_salary
FROM EMPLOYEES
Group by department;

---14 solutions
SELECT department, count(*) as total_employees
FROM EMPLOYEES
Group by department
having count(*)>1;

---15 solutions
SELECT customer_id, SUM(amount) as total_amount
FROM ORDERS
Group by customer_id;
---16 solutions
SELECT department, MAX(salary) as higest_salary
FROM EMPLOYEES
Group by department;

--- 17 solutions subqueries
Select * 
From EMPLOYEES as e
Where salary >
(SELECT AVG(salary) 
FROM EMPLOYEES as e2
Where e2.department = e.department)
--18 solution
Select  MAX(salary) as higest_salary
From EMPLOYEES
Where salary <
(SELECT MAX(salary)
FROM EMPLOYEES);

--19 solutions
SELECT customer_id, SUM(amount) As total_spent
FROM Orders
Group by customer_id
order by total_spent DESC
Limit 1;

--20 solutions
SELECT order_date, SUM(amount) As total_sales
FROM Orders
Group by order_date;

